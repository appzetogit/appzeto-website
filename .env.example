# Copy to .env.local (dev) or the server's env file (production).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=appzeto_website
ADMIN_USER=admin
# From: npm run admin:password
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Where CVs are stored (outside the web root)
UPLOAD_DIR=/var/lib/appzeto-website/uploads
